{
  "name": "image-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Layered image editor that runs standalone in Docker or mounted inside skillsmaster.",
  "license": "GPL-3.0-or-later",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run test:server && npm run test:web",
    "test:web": "jest",
    "test:server": "node --disable-warning=ExperimentalWarning --test server/__tests__/*.test.mjs",
    "start": "node --disable-warning=ExperimentalWarning server/index.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "konva": "^9.3.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/jsdom": "^20.0.1",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jsdom": "^20.0.3",
    "ts-jest": "^29.3.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
