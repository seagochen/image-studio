    "baseUrl": "https://skillsmaster.example.com",
    "customerKeyFile": "/run/secrets/image-studio/skillsmaster-customer-key",
    "manifestPath": "/mode-manifest",
    "runsPath": "/v1/runs",
    "requestTimeoutMs": 60000
  }
}
