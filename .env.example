# Copy to .env and adjust. docker compose reads this file automatically.
# Host-side mappings for the standalone container; the container side is fixed by
# config/standalone.json (port 80, /data/db and /data/storage).

# Host address and port the editor is published on (http://localhost:3000).
# Keep 127.0.0.1 unless you also set access.tokenFile in the config file; without it
# the server answers only requests addressed to localhost.
IMAGE_STUDIO_BIND_ADDRESS=127.0.0.1
IMAGE_STUDIO_HOST_PORT=3000

# Container port; must match server.port in the config file.
IMAGE_STUDIO_CONTAINER_PORT=80

# Runtime config file mounted read-only at /etc/image-studio/config.json.
IMAGE_STUDIO_CONFIG_FILE=./config/standalone.json

# Host folders for the SQLite database and for project assets / AI results.
IMAGE_STUDIO_DB_DIR=./data/db
IMAGE_STUDIO_STORAGE_DIR=./data/storage

# Folder holding secret files (skillsmaster customer key, access token, basic-auth password).
IMAGE_STUDIO_SECRETS_DIR=./secrets

# UID:GID the container runs as; must be able to write the two data folders.
IMAGE_STUDIO_UID=1000
IMAGE_STUDIO_GID=1000
